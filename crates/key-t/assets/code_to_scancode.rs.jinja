/// Translate a W3C [`KeyboardEvent.code`] to a Windows [`scancode`].
///
/// [`KeyboardEvent.code`]: https://w3c.github.io/uievents-code/#code-value-tables
/// [`scancode`]: https://learn.microsoft.com/en-us/windows/win32/inputdev/about-keyboard-input#scan-codes
fn code_to_scancode(code: &str) -> Option<u16> {
    let scancode = match code {
    {%- for code, scancode in codes %}
        {{ code }} => {{ scancode }},
    {%- endfor %}
        _ => return None,
    };
    Some(scancode)
}
