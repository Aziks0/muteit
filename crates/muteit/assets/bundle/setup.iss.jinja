{#
  NOTE: We use a template instead of `iscc /D"key=value"` and `{#key}` because
  `UsePreviousPrivileges=yes` requires `AppId` to not use constant (i.e not use the `{}` syntax).
-#}

#define InstalledExePath "{app}\" + "{{ NAME }}" + ".exe"

[Setup]
AppName={{ NAME }}
AppVerName={{ NAME }}
AppVersion={{ VERSION }}
AppCopyright={{ COPYRIGHT }}
AppPublisher={{ COMPANY_NAME }}
AppPublisherURL=https://github.com/Aziks0/muteit
AppSupportURL=https://github.com/Aziks0/muteit
AppUpdatesURL=https://github.com/Aziks0/muteit
LicenseFile={{ LICENSE_PATH }}
SetupIconFile={{ ICON_PATH }}
UninstallDisplayIcon={{ '{#InstalledExePath}' }}

AppId={{ APP_ID }}
AppMutex={{ APP_ID }}
SetupMutex={{ APP_ID }}-setup,Global\{{ APP_ID }}-setup

ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.0

DefaultDirName={autopf}\{{ NAME }}
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
UsePreviousPrivileges=yes

DisableProgramGroupPage=yes
AllowNoIcons=yes

LanguageDetectionMethod=none
ShowLanguageDialog=no

WizardStyle=modern dynamic
DisableFinishedPage=yes

[Tasks]
Name: autostart; \
  Description: "Open the application on system startup (only for the current user)"; \
  Check: IsAdminInstallMode
Name: autostart; \
  Description: "Open the application on system startup"; \
  Check: not IsAdminInstallMode

Name: desktopicon; Description: "Create a desktop shortcut"; Flags: unchecked
Name: desktopicon\hidden; Description: "Don't show the settings window"
Name: desktopicon\common; Description: "For all users"; Flags: exclusive; Check: IsAdminInstallMode
Name: desktopicon\user; \
  Description: "For the current user only"; \
  Flags: exclusive unchecked; \
  Check: IsAdminInstallMode

[Files]
Source: "{{ EXE_PATH }}"; DestDir: "{app}"

[Icons]
Name: "{autostartmenu}\{{ NAME }}"; \
  Filename: "{{ '{#InstalledExePath}' }}"; \
  Check: not WizardNoIcons

Name: "{userdesktop}\{{ NAME }}"; \
  Filename: "{{ '{#InstalledExePath}' }}"; \
  Parameters: "{code:GetShortcutParameters}"; \
  Tasks: desktopicon; \
  Check: not IsAdminInstallMode
Name: "{commondesktop}\{{ NAME }}"; \
  Filename: "{{ '{#InstalledExePath}' }}"; \
  Parameters: "{code:GetShortcutParameters}"; \
  Tasks: desktopicon\common; \
  Check: IsAdminInstallMode
Name: "{userdesktop}\{{ NAME }}"; \
  Filename: "{{ '{#InstalledExePath}' }}"; \
  Parameters: "{code:GetShortcutParameters}"; \
  Tasks: desktopicon\user; \
  Check: IsAdminInstallMode

[Registry]
Root: HKCU; \
  Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; \
  ValueType: string; \
  ValueName: "{{ NAME }}"; \
  ValueData: "{{ '{#InstalledExePath}' }} --hidden"; \
  Flags: uninsdeletevalue; \
  Tasks: autostart

[Run]
Filename: "{{ '{#InstalledExePath}' }}"; \
  Parameters: "{code:GetExecutableRunParameters}"; \
  Flags: nowait

[Code]
function GetShortcutParameters(Param: String): String;
begin
  if WizardIsTaskSelected('desktopicon\hidden') then
    Result := '--hidden'
  else
    Result := '';
end;

const
  WebView2GUID = '{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}';

{ Return the full version, or an empty string if WebView2 is not installed. }
function GetWebView2VersionFull(): String;
var
  Res: Boolean;
begin
  Result := '';

  Res := RegQueryStringValue(
    HKLM,
    'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\' + WebView2GUID,
    'pv',
    Result
  );
  if Res then Exit;

  RegQueryStringValue(
    HKCU,
    'SOFTWARE\Microsoft\EdgeUpdate\Clients\' + WebView2GUID,
    'pv',
    Result
  );
end;

{ Return the `MAJOR` version, or `-1` if WebView2 is not installed. }
function GetWebView2Version(): Integer;
var
  Version: String;
  VersionSplit: array of String;
begin
  Result := -1;

  Version := GetWebView2VersionFull();
  if Length(Version) = 0 then Exit;

  VersionSplit := StringSplit(Version, ['.'], stExcludeEmpty);
  if GetArrayLength(VersionSplit) <> 4 then Exit;

  Result := StrToInt(VersionSplit[0]);
end;

const
  InstallerFilename = 'MicrosoftEdgeWebView2RuntimeInstallerX64.exe';
function InstallWebView2(AlertPage: TWizardPage): Boolean;
var
  DownloadPage: TDownloadWizardPage;
  InstallPage: TOutputMarqueeProgressWizardPage;
  ExitCode: Integer;
  ErrorMessage: String;
begin
  Result := False;

  { Setup the downloader. }
  DownloadPage := CreateDownloadPage('WebView2', 'Downloading WebView2 installer.', nil);
  DownloadPage.Clear;
  DownloadPage.Add('https://go.microsoft.com/fwlink/?linkid=2124701', InstallerFilename, '');

  { Setup the installer page. }
  InstallPage := CreateOutputMarqueeProgressPage('WebView2', 'Installing WebView2.');

  { Start the download. }
  DownloadPage.Show;
  try
    DownloadPage.Download;
  except
    if not DownloadPage.AbortedByUser then begin
      ErrorMessage := GetExceptionMessage;
      SuppressibleMsgBox(ErrorMessage, mbCriticalError, MB_OK, IDOK);
      Log(ErrorMessage);
    end;

    DownloadPage.Hide;
    Exit;
  end;
  DownloadPage.Hide;

  { Start the installation. }
  InstallPage.Show;
  if not Exec(
    ExpandConstant('{tmp}\') + InstallerFilename,
    '/install',
    '',
    SW_SHOW,
    ewWaitUntilTerminated,
    ExitCode
  ) then begin
    ErrorMessage := 'Error executing WebView2 installer script.';
    SuppressibleMsgBox(ErrorMessage, mbCriticalError, MB_OK, IDOK);
    Log(ErrorMessage);
    InstallPage.Hide;
    Exit;
  end;

  { Check if installation succeeded. }
  if ExitCode <> 0 then begin
    ErrorMessage := 'WebView2 installation failed with exit code: ' + IntToStr(ExitCode);
    SuppressibleMsgBox(ErrorMessage, mbCriticalError, MB_OK, IDOK);
    Log(ErrorMessage);
    InstallPage.Hide;
    Exit;
  end;
  InstallPage.Hide;

  Result := True;
end;

type
  TLevel = (LevelSystem, LevelUser);

{ Get the path to the updater, and the level needed to use it. }
{ Return `True` if the updater was found, `False` otherwise. }
{ NOTE: `OutPath` and `OutLevel` are not changed when this function returns `False`. }
function GetWebView2Updater(var OutPath: String; var OutLevel: TLevel): Boolean;
begin
  Result := RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate', 'path', OutPath);
  if Result then begin
    OutLevel := LevelSystem;
    Exit;
  end;

  Result := RegQueryStringValue(HKCU, 'SOFTWARE\Microsoft\EdgeUpdate', 'path', OutPath);
  if Result then OutLevel := LevelUser;
end;

function UpdateWebView2(AlertPage: TWizardPage): Boolean;
var
  UpdatePage: TOutputMarqueeProgressWizardPage;
  UpdaterPath: String;
  UpdaterLevel: TLevel;
  UpdaterArguments: String;
  ErrorMessage: String;
  ExitCode: Integer;
begin
  Result := False;

  { Setup the update page.}
  UpdatePage := CreateOutputMarqueeProgressPage('WebView2', 'Updating WebView2.');
  UpdatePage.Show;
  
  { Find the path to the updater. }
  if not GetWebView2Updater(UpdaterPath, UpdaterLevel) then begin
    ErrorMessage := 'WebView2 updater not found.';
    SuppressibleMsgBox(ErrorMessage, mbCriticalError, MB_OK, IDOK);
    Log(ErrorMessage);
    UpdatePage.Hide;
    Exit;
  end;

  { Start the update. }
  UpdaterArguments := '/install appguid=' + WebView2GUID;
  if UpdaterLevel = LevelSystem then UpdaterArguments := UpdaterArguments + '&needsadmin=true';
  if not Exec(
    UpdaterPath,
    UpdaterArguments,
    '',
    SW_SHOW,
    ewWaitUntilTerminated,
    ExitCode
  ) then begin
    ErrorMessage := 'Error executing WebView2 updater.';
    SuppressibleMsgBox(ErrorMessage, mbCriticalError, MB_OK, IDOK);
    Log(ErrorMessage);
    UpdatePage.Hide;
    Exit;
  end;

  { Check if update succeeded. }
  if ExitCode <> 0 then begin
    ErrorMessage := 'WebView2 update failed with exit code: ' + IntToStr(ExitCode);
    SuppressibleMsgBox(ErrorMessage, mbCriticalError, MB_OK, IDOK);
    Log(ErrorMessage);
    UpdatePage.Hide;
    Exit;
  end;
  UpdatePage.Hide;

  Result := True;
end;

procedure SetupWebView2Page(Version: Integer);
var
  Description: String;
  Message: String;
  OnNextButtonClick: TWizardPageButtonEvent;
  AlertPage: TOutputMsgWizardPage;
begin
  if Version < 0 then begin
    Log('WebView2 installation required.');
    Description := 'WebView2 needs to be updated.';
    Message := 'This program requires WebView2 to be installed, but no installation could be found'
      + ' on your system.'#13#10#13#10
      + 'Click Next to download and install WebView2. This requires an internet connection.';
    OnNextButtonClick := @InstallWebView2;
  end else begin
    Log('WebView2 update required.');
    Description := 'WebView2 needs to be installed.';
    Message :=
      'This program requires WebView2 to be installed, with a version greater or equal than v'
      + '{{ WEBVIEW2_MINIMUM_VERSION }}'
      + '. Version v' + IntToStr(Version) + ' was found on your system.'#13#10#13#10
      + 'Click Next to update WebView2. This requires an internet connection and might require'
      + ' Admin privileges.';
    OnNextButtonClick := @UpdateWebView2;
  end;

  AlertPage := CreateOutputMsgPage(wpSelectDir, 'WebView2', Description, Message);
  AlertPage.OnNextButtonClick := OnNextButtonClick;
end;

procedure InitializeWizard;
var
  WebView2Version: Integer;
begin
  WebView2Version := GetWebView2Version();
  if WebView2Version >= {{ WEBVIEW2_MINIMUM_VERSION }} then Exit;

  SetupWebView2Page(WebView2Version);
end;

var
  IsUpdating: Boolean;

function GetExecutableRunParameters(Param: String): String;
begin
  if IsUpdating then
    Result := '--hidden'
  else
    Result := '';
end;

procedure RegisterPreviousData(PreviousDataKey: Integer);
begin
  { Make sure the next setup will be considered an update. }
  SetPreviousData(PreviousDataKey, 'Exist', '1');
end;

function InitializeSetup(): Boolean;
begin
  { We can't call `GetPreviousData` in `GetExecutableRunParameters` because it gets called in the }
  { `Run` section, which happens after `RegisterPreviousData` is called, so the value is obviously }
  { already registered. }
  IsUpdating := SameText(GetPreviousData('Exist', ''), '1');

  Result := True;
end;
