{#
  NOTE: We use a template instead of `iscc /D"key=value"` and `{#key}` because
  `UsePreviousPrivileges=yes` requires `AppId` to not use constant (i.e not use the `{}` syntax).
-#}

#define InstalledExePath "{app}\" + "{{ NAME }}" + ".exe"

[Setup]
AppName={{ NAME }}
AppVerName={{ NAME }}
AppVersion={{ VERSION }}
AppCopyright={{ COPYRIGHT }}
AppPublisher={{ COMPANY_NAME }}
AppPublisherURL=https://github.com/Aziks0/muteit
AppSupportURL=https://github.com/Aziks0/muteit
AppUpdatesURL=https://github.com/Aziks0/muteit
LicenseFile={{ LICENSE_PATH }}
SetupIconFile={{ ICON_PATH }}
UninstallDisplayIcon={{ '{#InstalledExePath}' }}

AppId={{ APP_ID }}
AppMutex={{ APP_ID }}
SetupMutex={{ APP_ID }}-setup,Global\{{ APP_ID }}-setup

ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.0

DefaultDirName={autopf}\{{ NAME }}
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
UsePreviousPrivileges=yes

DisableProgramGroupPage=yes
AllowNoIcons=yes

LanguageDetectionMethod=none
ShowLanguageDialog=no

WizardStyle=modern dynamic
DisableFinishedPage=yes

[Tasks]
Name: autostart; \
  Description: "Open the application on system startup (only for the current user)"; \
  Check: IsAdminInstallMode
Name: autostart; \
  Description: "Open the application on system startup"; \
  Check: not IsAdminInstallMode

Name: desktopicon; Description: "Create a desktop shortcut"; Flags: unchecked
Name: desktopicon\hidden; Description: "Don't show the settings window"
Name: desktopicon\common; Description: "For all users"; Flags: exclusive; Check: IsAdminInstallMode
Name: desktopicon\user; \
  Description: "For the current user only"; \
  Flags: exclusive unchecked; \
  Check: IsAdminInstallMode

[Files]
Source: "{{ EXE_PATH }}"; DestDir: "{app}"

[Icons]
Name: "{autostartmenu}\{{ NAME }}"; \
  Filename: "{{ '{#InstalledExePath}' }}"; \
  Check: not WizardNoIcons

Name: "{userdesktop}\{{ NAME }}"; \
  Filename: "{{ '{#InstalledExePath}' }}"; \
  Parameters: "{code:GetShortcutParameters}"; \
  Tasks: desktopicon; \
  Check: not IsAdminInstallMode
Name: "{commondesktop}\{{ NAME }}"; \
  Filename: "{{ '{#InstalledExePath}' }}"; \
  Parameters: "{code:GetShortcutParameters}"; \
  Tasks: desktopicon\common; \
  Check: IsAdminInstallMode
Name: "{userdesktop}\{{ NAME }}"; \
  Filename: "{{ '{#InstalledExePath}' }}"; \
  Parameters: "{code:GetShortcutParameters}"; \
  Tasks: desktopicon\user; \
  Check: IsAdminInstallMode

[Registry]
Root: HKCU; \
  Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; \
  ValueType: string; \
  ValueName: "{{ NAME }}"; \
  ValueData: "{{ '{#InstalledExePath}' }} --hidden"; \
  Flags: uninsdeletevalue; \
  Tasks: autostart

[Run]
Filename: "{{ '{#InstalledExePath}' }}"; \
  Parameters: "{code:GetExecutableRunParameters}"; \
  Flags: nowait

[Code]
function GetShortcutParameters(Param: String): String;
begin
  if WizardIsTaskSelected('desktopicon\hidden') then
    Result := '--hidden'
  else
    Result := '';
end;

var
  IsUpdating: Boolean;

function GetExecutableRunParameters(Param: String): String;
begin
  if IsUpdating then
    Result := '--hidden'
  else
    Result := '';
end;

procedure RegisterPreviousData(PreviousDataKey: Integer);
begin
  { Make sure the next setup will be considered an update. }
  SetPreviousData(PreviousDataKey, 'Exist', '1');
end;

function InitializeSetup(): Boolean;
begin
  { We can't call `GetPreviousData` in `GetExecutableRunParameters` because it gets called in the }
  { `Run` section, which happens after `RegisterPreviousData` is called, so the value is obviously }
  { already registered. }
  IsUpdating := SameText(GetPreviousData('Exist', ''), '1');

  Result := True;
end;
