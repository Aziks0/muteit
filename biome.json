{
  "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
  "files": {
    "includes": [
      "**/.json",
      "!!.jj",
      "!!target",
      "crates/muteit/**/*.js",
      "crates/muteit/**/*.ts",
      "crates/muteit/**/*.css",
      "!crates/muteit/assets/tailwind.css"
    ]
  },
  "vcs": {
    "enabled": false
  },
  "linter": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
